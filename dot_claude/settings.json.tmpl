  "hooks": {
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/theduy/.claude/hooks/worktree-env-copy.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/Users/theduy/.claude/hooks/worktree-tab-rename.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/Users/theduy/.claude/hooks/worktree-s-auto-enforcer.sh",
            "timeout": 5
          }
        ]
      },
      {
        "_comment": "DOCTOR 2026-08-07: narrowed from Edit|Write|Bash. Fired on 11,406 Bash calls in 2.8 days (~9.3h blocking) re-indexing a 0-node graph. Restore by adding |Bash back.",
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph status || true",
            "timeout": 10
          }
        ],
        "_comment": "DOCTOR 2026-08-07: gated on git-repo. Ran unconditionally incl. ~ (not a git repo, graph 0 nodes) costing 5.4s median at every SessionStart. rev-parse costs ~5ms to skip it."
      }
    ],
    "UserPromptSubmit": [
      {
        "_comment": "Added 2026-08-11. Records turn-start epoch to $TMPDIR for the Stop hook's duration clause. MUST stay silent on stdout — UserPromptSubmit stdout is injected into Claude's context.",
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/theduy/.claude/hooks/turn-start-stamp.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "_comment": "Added 2026-08-11. Prints '✓ done <date time> · took <dur>' via JSON systemMessage (Stop discards plain stdout), landing above the recap/away-summary line. Fail-open; drops the duration clause if no marker.",
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/theduy/.claude/hooks/turn-done-timestamp.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"/opt/homebrew/bin/node\" \"/Users/theduy/.claude/hooks/worktree-path-guard.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"/opt/homebrew/bin/node\" \"/Users/theduy/.claude/hooks/salonx-worktree-guard.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"/opt/homebrew/bin/node\" \"/Users/theduy/.claude/hooks/worktree-branch-guard.js\"",
            "timeout": 15
          }
        ]
      },
      {
        "_comment": "Wired 2026-08-08. Was documented as active in salonx/CLAUDE.md but registered in NO settings file. Self-gates on scripts/claim.mjs existing in the repo root, so inert elsewhere. Fail-open; bypass SALONX_NO_CLAIM=1.",
        "matcher": "EnterWorktree|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"/opt/homebrew/bin/node\" \"/Users/theduy/.claude/hooks/salonx-claim-guard.js\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
